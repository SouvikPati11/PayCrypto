# PayCrypto — copy to .env and fill in. NEVER commit a real .env, seed phrase,
# private key, API key, database password or JWT secret to GitHub.
# See docs/HOSTINGER.md, docs/WALLET.md and docs/PRODUCTION_READINESS.md.

PORT=3000
NODE_ENV=production
BASE_URL=https://paycrypto.example.com

# Database (MySQL, required in production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=paycrypto_user
DB_NAME=paycrypto
DB_PASSWORD=change-me-in-cpanel-not-here

# Demo / test only. MEMORY_DB=true runs without MySQL using an in-memory store.
# It is NOT production storage: data is lost on restart and is never a ledger.
MEMORY_DB=false

# Auth secrets — generate long random values, store only in the server .env
JWT_SECRET=change-me-to-a-long-random-value
SESSION_SECRET=change-me-to-a-different-long-random-value
ENCRYPTION_KEY=change-me-to-64-hex-chars-used-only-for-totp-and-wallet-metadata

# BNB Smart Chain — testnet is the safe default
BSC_NETWORK=testnet
# testnet chain 97, mainnet chain 56. BSC_RPC_URL overrides the default per network.
BSC_RPC_URL=
BSC_RPC_URL_MAINNET=https://bsc-dataseed.bnbchain.org
BSC_RPC_URL_TESTNET=https://bsc-testnet-dataseed.bnbchain.org

# USDT (BEP20) — mainnet contract verified against BscScan / BNB Chain listings:
# 0x55d398326f99059fF775485246999027B3197955, 18 decimals, chain 56.
# Re-verify on BscScan before production activation; the monitor enforces an
# exact contract-address match and rejects every other token contract.
USDT_CONTRACT_MAINNET=0x55d398326f99059fF775485246999027B3197955
# Testnet: DO NOT copy the mainnet address here. Deploy or use a BSC testnet
# faucet BEP20 test token, verify it on testnet BscScan, then set its address.
USDT_CONTRACT_TESTNET=

# Treasury — public address ONLY. Never put a treasury private key in .env.
TREASURY_ADDRESS=

# Payment policy
CONFIRMATIONS=12
REORG_DEPTH=12
INVOICE_EXPIRY_MINUTES=60
MIN_WITHDRAWAL_USDT=10
MAX_WITHDRAWAL_USDT=10000
WITHDRAWAL_FEE_USDT=1

# Safety gates — all default OFF. Real money stays disabled until the
# security, operational and legal reviews in docs/PRODUCTION_READINESS.md pass.
PAYMENTS_LIVE=false
AUTO_SWEEP=false
WITHDRAWAL_AUTO_BROADCAST=false
MAINTENANCE_MODE=false
EMERGENCY_PAUSE=false

# Optional: protects POST /cron/monitor if you use the HTTP trigger.
# Hostinger cron should call scripts/monitor.js directly instead.
CRON_SECRET=

# init-wallet only (NOT used by the web server; never put a real mnemonic here):
# WALLET_MNEMONIC=  # leave empty to generate a fresh mnemonic
# WALLET_OVERWRITE=false  # set to true only for a deliberate wallet rotation

# First admin (used only by scripts/seed-admin.js, then change the password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately
